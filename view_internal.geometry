#version 330 core

layout (triangles) in;
layout (triangle_strip, max_vertices = 3) out;

in vec3 UV1h[];
in vec3 UV2h[];

out vec3 UV1o;
out vec3 UV2o;

uniform uint layer;

void main()
{
	gl_Layer = int(layer);

	for(int i = 0; i < gl_in.length(); ++i)
	{
		gl_Position = gl_in[i].gl_Position;
		UV1o = UV1h[i];
		UV2o = UV2h[i];
		EmitVertex();
	}

	EndPrimitive();
}
