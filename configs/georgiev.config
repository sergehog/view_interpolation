<?xml version="1.0" encoding="utf-8"?>
<config>
  <input>
    <width>640</width>
    <height>480</height>
    <minZ>1</minZ>
    <maxZ>7</maxZ>
    <camera_file>Georgiev/georgiev.txt</camera_file>
    <!-- a row of five cameras 4 cm apart; Camera22 (middle) is held out as the initial virtual view,
         Georgiev/Color22.yuv is its ground truth. Fly sideways to switch between neighbouring pairs. -->
    <views>
      <view><file>Georgiev/Color20.yuv</file><camera>Camera20</camera></view>
      <view><file>Georgiev/Color21.yuv</file><camera>Camera21</camera></view>
      <view><file>Georgiev/Color23.yuv</file><camera>Camera23</camera></view>
      <view><file>Georgiev/Color24.yuv</file><camera>Camera24</camera></view>
    </views>
  </input>
  
  <settings>
    <layers>50</layers>
    <desired_camera>Camera22</desired_camera>
    <speed>-0.2</speed>
    <mouseSpeed>0.001</mouseSpeed>

    <output_width>1024</output_width>
    <output_height>768</output_height>

  </settings>
</config>

