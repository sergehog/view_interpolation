#version 330 core

in vec3 UV1o; // homogeneous texture coordinates, see view_internal.vertex
in vec3 UV2o;

//uniform uint width;
//uniform uint height;
//uniform uint layers;
uniform sampler2D Texture1;
uniform sampler2D Texture2;
uniform float param1; // optional cost threshold from the config (<param1>), 0 = default
const float default_cost_thr = 21.f/255;

// Ouput data
out vec4 colorOut;

void main()
{
	vec2 UV1 = UV1o.xy / UV1o.z;
	vec2 UV2 = UV2o.xy / UV2o.z;
	vec3 color1 = textureLod(Texture1, UV1, 0).bgr;
	vec3 color2 = textureLod(Texture2, UV2, 0).bgr;
	vec3 color1a = textureLod(Texture1, UV1, 2).bgr;
	vec3 color2a = textureLod(Texture2, UV2, 2).bgr;
	vec3 diff = abs(color1-color2)/4 + abs(color1a-color2a)/4;
	//vec3 diff = abs(color1-color2);
	float cost = diff.r + diff.g + diff.b;
	float cost_thr = param1 > 0 ? param1 : default_cost_thr;
	cost = cost > cost_thr ? 1.f : cost/cost_thr;

	// A 3D point behind an input camera or projecting outside its image cannot be matched:
	// clamp-to-edge sampling would otherwise produce false (often perfect) matches.
	bool valid1 = UV1o.z > 0 && all(greaterThanEqual(UV1, vec2(0))) && all(lessThanEqual(UV1, vec2(1)));
	bool valid2 = UV2o.z > 0 && all(greaterThanEqual(UV2, vec2(0))) && all(lessThanEqual(UV2, vec2(1)));
	if (!(valid1 && valid2))
	{
		cost = 1.f;
		color1 = valid1 ? color1 : color2;
		color2 = valid2 ? color2 : color1;
	}
	colorOut = vec4((color1+color2)/2, cost);
}
