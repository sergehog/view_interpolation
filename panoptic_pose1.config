<?xml version="1.0" encoding="utf-8"?>
<!--
  Multi-view video demo.
  CMU Panoptic Studio "171204_pose1_sample", HD cameras (1920x1080, 29.97 fps, 101 frames).
  Eight HD views around camera 00_22; each frame the pair of views that best brackets the
  virtual camera is chosen (see select_views() in view_interpolation.cpp).
  The virtual camera starts at the pose of HD camera 00_22, which is NOT used as an input,
  so the rendering can be compared with hdVideos/hd_00_22.mp4.
  World units are centimetres. data/171204_pose1_sample is a symlink created by demo_video1.sh.
-->
<config>
  <input>
    <!-- processing resolution: videos are scaled to it and intrinsics are rescaled accordingly -->
    <width>960</width>
    <height>540</height>
    <!-- depth range (cm from the virtual camera): the person is at ~190-370 cm, the dome walls up to ~700 cm -->
    <minZ>180</minZ>
    <maxZ>700</maxZ>
    <camera_file>data/171204_pose1_sample/calibration_171204_pose1_sample.json</camera_file>
    <views>
      <view><file>data/171204_pose1_sample/hdVideos/hd_00_02.mp4</file><camera>00_02</camera></view>
      <view><file>data/171204_pose1_sample/hdVideos/hd_00_03.mp4</file><camera>00_03</camera></view>
      <view><file>data/171204_pose1_sample/hdVideos/hd_00_05.mp4</file><camera>00_05</camera></view>
      <view><file>data/171204_pose1_sample/hdVideos/hd_00_07.mp4</file><camera>00_07</camera></view>
      <view><file>data/171204_pose1_sample/hdVideos/hd_00_09.mp4</file><camera>00_09</camera></view>
      <view><file>data/171204_pose1_sample/hdVideos/hd_00_12.mp4</file><camera>00_12</camera></view>
      <view><file>data/171204_pose1_sample/hdVideos/hd_00_15.mp4</file><camera>00_15</camera></view>
      <view><file>data/171204_pose1_sample/hdVideos/hd_00_18.mp4</file><camera>00_18</camera></view>
    </views>
    <!-- optional: <frames>N</frames> limits the loop length, <fps>F</fps> overrides the video frame rate -->
  </input>

  <settings>
    <vertex_shader>view.vertex</vertex_shader>
    <fragment_shader>view.fragment</fragment_shader>
    <vertex_internal>view_internal.vertex</vertex_internal>
    <geometry_internal>view_internal.geometry</geometry_internal>
    <fragment_internal>view_internal.fragment</fragment_internal>
    <layers>50</layers>
    <desired_camera>00_22</desired_camera>
    <!-- input views facing more than this many degrees away from the virtual camera are not used -->
    <max_view_angle>60</max_view_angle>
    <speed>-60</speed>
    <mouseSpeed>0.0001</mouseSpeed>
  </settings>
</config>
